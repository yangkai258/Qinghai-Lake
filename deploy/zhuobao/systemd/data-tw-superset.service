[Unit]
Description=Apache Superset (port 8088)
After=network-online.target postgresql.service

[Service]
Type=simple
User=zhuobao
WorkingDirectory=/opt/data-tw
EnvironmentFile=/opt/data-tw/.env
ExecStart=/usr/bin/gunicorn -w 4 -k gevent -b 127.0.0.1:8088 superset.app:create_app()
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
